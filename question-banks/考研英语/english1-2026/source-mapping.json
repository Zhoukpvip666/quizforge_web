  {
    "number": 46,
    "type": "英译汉",
    "source": "p.13",
    "parentId": "translation-01",
    "partId": "q-46",
    "maxScoreProposal": 2,
    "answerSource": "PDF p.15",
    "sourceAnswer": "追溯这一术语的历史，我们可以看到科学素养的定义如何随时间推移而演变，这使得在确定科学教育的目标时，情况变得模糊不清。",
    "status": "已制作；按PDF附录核对",
    "extension": {
      "development": "segment-translation-2026-dev"
    }
  },
  {
    "number": 47,
    "type": "英译汉",
    "source": "p.13",
    "parentId": "translation-01",
    "partId": "q-47",
    "maxScoreProposal": 2,
    "answerSource": "PDF p.15",
    "sourceAnswer": "回归到那个版本的科学素养理念——它更侧重于教授科学的本质与运作方式，而非记忆科学事实——似乎正是当今社会所亟需的。",
    "status": "已制作；按PDF附录核对",
    "extension": {
      "development": "segment-translation-2026-dev"
    }
  },
  {
    "number": 48,
    "type": "英译汉",
    "source": "p.13",
    "parentId": "translation-01",
    "partId": "q-48",
    "maxScoreProposal": 2,
    "answerSource": "PDF p.15",
    "sourceAnswer": "教育家们提出了让学生在高中阶段完成详细实验训练的主张，他们认为这类训练的主要益处在于能提升逻辑推理和观察能力。",
    "status": "已制作；按PDF附录核对",
    "extension": {
      "development": "segment-translation-2026-dev"
    }
  },
  {
    "number": 49,
    "type": "英译汉",
    "source": "p.13",
    "parentId": "translation-01",
    "partId": "q-49",
    "maxScoreProposal": 2,
    "answerSource": "PDF p.15",
    "sourceAnswer": "直到20世纪40年代“科学素养”这一说法出现，科学才拥有了一个极具号召力的口号，得以赢得公众关注，并将改善科学教育确立为一项重要的国家目标。",
    "status": "已制作；按PDF附录核对",
    "extension": {
      "development": "segment-translation-2026-dev"
    }
  },
