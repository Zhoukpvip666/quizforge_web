{
  "id": "quizforge.true-false",
  "version": "2.0.0",
  "name": "判断题",
  "description": "基础富文本判断题界面原型，未接入真实保存与评分。",
  "requiresApi": {
    "major": 1,
    "minMinor": 3,
    "capabilities": [
      "practice",
      "editor",
      "score",
      "richtext",
      "resources",
      "lifecycle",
      "answer-state"
    ]
  },
  "requiresRichText": {
    "major": 1,
    "minMinor": 0,
    "documentFormat": 1,
    "documentProfile": "advanced-v1",
    "capabilities": [
      "basic-formatting",
      "images",
      "advanced-formatting",
      "tables",
      "math",
      "image-resize"
    ]
  },
  "entry": "practice.html",
  "script": "practice.js",
  "style": "practice.css",
  "rules": "rules.js",
  "questionSchema": "question.schema.json",
  "answerSchema": "answer.schema.json",
  "examples": "examples/bank.json"
}
