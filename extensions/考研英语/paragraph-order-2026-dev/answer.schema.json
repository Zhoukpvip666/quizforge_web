{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "responses"
  ],
  "properties": {
    "responses": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 64
      }
    }
  }
}
